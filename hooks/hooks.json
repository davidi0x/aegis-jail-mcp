{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|LS|Bash|WebFetch|WebSearch|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/aegis.py\" hook claude-pretooluse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
